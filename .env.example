# LLM (generation / query rewriting / HyDE only — everything else is local)
MINIMAX_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2.7

# Models: full (spec defaults) | dev (small+fast) | stub (no downloads, tests)
MODEL_PROFILE=full
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual   # or Qwen/Qwen3-Reranker-0.6B

# Retrieval weights (authority-aware final rank; logged per result)
# W_CROSS_ENCODER=0.6
# W_AUTHORITY=0.25
# W_RECENCY=0.15
# LOW_CONFIDENCE_THRESHOLD=0.25
