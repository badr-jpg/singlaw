# LLM (generation / query rewriting / HyDE only — everything else is local)
MINIMAX_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2.7
# Helper calls (analysis / rewrites / HyDE / doc context) use a faster variant; the
# answer keeps LLM_MODEL. Pre-retrieval LLM work is capped at this many seconds.
# LLM_FAST_MODEL=MiniMax-M2.7-highspeed
# LLM_PRESTAGE_BUDGET_SECONDS=15

# Models: full (spec defaults) | dev (small+fast) | stub (no downloads, tests)
MODEL_PROFILE=full
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual   # or Qwen/Qwen3-Reranker-0.6B

# Retrieval weights (authority-aware final rank; logged per result)
# W_CROSS_ENCODER=0.6
# W_AUTHORITY=0.25
# W_RECENCY=0.15
# LOW_CONFIDENCE_THRESHOLD=0.25

# --- v2: workspaces / editorial content ---
# Optional operator ceiling on business workspaces (0 = follow the active plan's limit).
# MAX_BUSINESSES=0
# Folder holding suggestions.json + discoveries.json (edited without a restart).
# Defaults to <repo>/data/content; use an absolute path if you override it.
# CONTENT_DIR=/absolute/path/to/content

# --- v2: billing (all optional) ---
# Without STRIPE_SECRET_KEY + STRIPE_PRICE_IDS, POST /api/billing/checkout answers
# 503 "Checkout is not configured yet" and the UI offers the waitlist instead.
# STRIPE_SECRET_KEY=sk_test_...
# JSON map of "<plan_id>:<interval>" -> Stripe Price id (monthly | yearly)
# STRIPE_PRICE_IDS={"business:monthly": "price_...", "business:yearly": "price_..."}
# Signing secret for POST /api/billing/webhook (from the Stripe dashboard or
# `stripe listen --forward-to localhost:8000/api/billing/webhook`). When unset,
# events are accepted unverified ONLY if STRIPE_SECRET_KEY is set (local dev).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Origin used for Checkout success/cancel redirects (…/billing?checkout=success)
# PUBLIC_BASE_URL=http://localhost:8000
